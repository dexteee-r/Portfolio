[Unit]
Description=ELMZN: bring the site up to the newest published image
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/elmzn/deploy.sh
# A first start or a cache warm-up can take a few minutes, never ten.
TimeoutStartSec=10min
