# Copy to .env.local for local development; set the same variables in Vercel
# (Project → Settings → Environment Variables) for the deployed site.

# CMS (Sveltia) — the GitHub repository it commits to, as owner/name.
CMS_GITHUB_REPO=dexteee-r/Portfolio
# Branch the site deploys from.
CMS_GITHUB_BRANCH=main
# "public_repo" is enough for a public repository (this one); "repo" for a private one.
CMS_GITHUB_SCOPE=public_repo

# GitHub OAuth App for signing in to /admin
# (GitHub → Settings → Developer settings → OAuth Apps → New OAuth App):
#   Homepage URL:               https://elmzn.be
#   Authorization callback URL: https://elmzn.be/api/cms/callback
# The secret stays on the server; never commit a real value.
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
